#!/bin/bash
# Speak one chunk of story text (used by rdstory).
# Prefer a stable Linux espeak/espeak-ng pipeline: write WAV, then play it.
# Avoids (1) turning every "." into ";" (long pauses / choppy bursts) and
# (2) stuffing the whole paragraph into argv (fragile) while reopening the
# audio device in a way that gets flaky after many paragraphs.

set -euo pipefail

TMPDIR="${TMPDIR:-/tmp}"
TXT="$TMPDIR/rdme-$$.txt"
WAV="$TMPDIR/rdme-$$.wav"
cleanup() { rm -f "$TXT" "$WAV"; }
trap cleanup EXIT

cat >"$TXT"

# Highlight repeats in the terminal (best-effort; ignore failures)
if command -v showtxt >/dev/null 2>&1; then
  showtxt "$TXT" || true
fi

# Strip markup / normalize punctuation for TTS (keep sentence periods!)
perl -i -ne '
  s/<[^>]*>//g;
  s/—/--/g;
  s/–/-/g;
  s/’|\x{2019}/'\''/g;
  s/“|”/"/g;
  s/…/.../g;
  s/\s+/ /g;
  s/^\s+|\s+$//g;
  print $_, "\n" if length;
' "$TXT"

[[ -s "$TXT" ]] || exit 0

WIN_ESPEAK="/mnt/c/Program Files (x86)/eSpeak/command_line/espeak.exe"
ESPEAK_BIN=""
# Prefer native Linux engines; Windows espeak via WSL gets glitchy after sustained use.
if [[ -n "${RDME_ESPEAK:-}" && -x "${RDME_ESPEAK}" ]]; then
  ESPEAK_BIN="$RDME_ESPEAK"
elif command -v espeak-ng >/dev/null 2>&1; then
  ESPEAK_BIN="$(command -v espeak-ng)"
elif command -v espeak >/dev/null 2>&1; then
  ESPEAK_BIN="$(command -v espeak)"
elif [[ -x "$WIN_ESPEAK" ]]; then
  ESPEAK_BIN="$WIN_ESPEAK"
else
  echo "rdme: no espeak/espeak-ng found" >&2
  exit 1
fi

SPEED="${RDME_SPEED:-250}"

play_wav() {
  local wav="$1"
  if command -v paplay >/dev/null 2>&1; then
    paplay "$wav"
  elif command -v pw-play >/dev/null 2>&1; then
    pw-play "$wav"
  elif command -v aplay >/dev/null 2>&1; then
    aplay -q "$wav"
  else
    return 1
  fi
}

# WAV + play is more stable across Pulse/PipeWire/WSL than espeak opening
# the device directly on every paragraph.
if [[ "$ESPEAK_BIN" != *".exe" ]] && "$ESPEAK_BIN" -s "$SPEED" -f "$TXT" -w "$WAV" 2>/dev/null; then
  if play_wav "$WAV"; then
    exit 0
  fi
fi

# Fallback: direct playback from file (still better than argv)
"$ESPEAK_BIN" -s "$SPEED" -f "$TXT"

